  "all_codecs": false,
  "hide_members_only": false,
  "original_titles": false,
  "download_dir": "",
  "key_bindings": [
    {"action": "set_light_theme", "mod": "", "key": "F2"},
    {"action": "set_dark_theme", "mod": "", "key": "F3"},
    {"action": "set_yuuka_theme", "mod": "", "key": "F4"},
    {"action": "clear_thumbnail_cache", "mod": "CTRL-ALT", "key": "C"}
